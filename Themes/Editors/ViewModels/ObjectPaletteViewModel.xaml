<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:Frosty.Controls;assembly=FrostyControls"
    xmlns:editors="clr-namespace:LevelEditorPlugin.Editors"
    xmlns:managers="clr-namespace:LevelEditorPlugin.Managers">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/FrostyControls;component/Themes/Generic.xaml" />
        <ResourceDictionary Source="/LevelEditorPlugin;component/Themes/Common.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- 目录节点 -->
    <HierarchicalDataTemplate DataType="{x:Type editors:ObjectPaletteFolder}" ItemsSource="{Binding Path=Children}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="19" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Rectangle
                x:Name="imageRect"
                Width="16"
                Height="16"
                Margin="3,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Fill="White">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="/FrostyEditor;component/Images/CloseFolder.png" />
                </Rectangle.OpacityMask>
            </Rectangle>

            <TextBlock
                Grid.Column="1"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Text="{Binding Path=Name}" />
        </Grid>
        <HierarchicalDataTemplate.Triggers>
            <DataTrigger Binding="{Binding Path=IsExpanded}" Value="True">
                <Setter TargetName="imageRect" Property="OpacityMask">
                    <Setter.Value>
                        <ImageBrush ImageSource="/FrostyEditor;component/Images/OpenFolder.png" />
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </HierarchicalDataTemplate.Triggers>
    </HierarchicalDataTemplate>

    <!-- 蓝图叶子节点 -->
    <DataTemplate DataType="{x:Type managers:ObjectPaletteEntry}">
        <Grid ToolTip="{Binding Path=FilePath}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="19" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image
                Width="16"
                Height="16"
                Margin="3,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Source="{Binding Path=Icon}" />

            <TextBlock
                Grid.Column="1"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Text="{Binding Path=DisplayName}"
                TextTrimming="CharacterEllipsis" />

            <TextBlock
                Grid.Column="2"
                Margin="8,0,6,0"
                VerticalAlignment="Center"
                FontSize="10"
                Foreground="#8C8C8C"
                Text="{Binding Path=SourceText}" />
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type editors:ObjectPaletteViewModel}">
        <ctrl:FrostyDockablePanel BorderVisible="False" TitleBarVisible="False">
            <Border BorderBrush="{StaticResource ControlBackground}" BorderThickness="0,2,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26" />
                        <RowDefinition Height="24" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="22" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="1,1,1,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="26" />
                        </Grid.ColumnDefinitions>

                        <ctrl:FrostyWatermarkTextBox
                            x:Name="PART_FilterTextBox"
                            Height="24"
                            Padding="4,0,0,0"
                            HorizontalAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            BorderThickness="1"
                            WatermarkText="Filter">
                            <ctrl:FrostyWatermarkTextBox.Text>
                                <Binding Path="FilterText" UpdateSourceTrigger="PropertyChanged" />
                            </ctrl:FrostyWatermarkTextBox.Text>
                        </ctrl:FrostyWatermarkTextBox>

                        <Button
                            Grid.Column="1"
                            Width="22"
                            Height="22"
                            Margin="4,1,0,1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Command="{Binding Path=RefreshCommand}"
                            ToolTip="重新扫描关卡素材">
                            <TextBlock FontSize="12" Text="⟳" />
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" Margin="1,0,1,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <ComboBox
                            x:Name="PART_TargetSubWorldComboBox"
                            Height="22"
                            VerticalContentAlignment="Center"
                            FontSize="11"
                            DisplayMemberPath="Label"
                            ItemsSource="{Binding Path=TargetSubWorlds}"
                            SelectedItem="{Binding Path=SelectedTargetSubWorld, Mode=TwoWay}"
                            ToolTip="放置目标 SubWorld：Auto = 按 levelart / content 命名自动解析；也可手动指定">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="{x:Type ComboBoxItem}">
                                    <Setter Property="ToolTip" Value="{Binding Path=Detail}" />
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>
                    </Grid>

                    <TreeView
                        Grid.Row="2"
                        editors:DragDropExtension.IsDragDropSource="True"
                        editors:LevelEditorAttachedBehaviors.LoadedCommand="{Binding Path=LoadedCommand}"
                        editors:LevelEditorAttachedBehaviors.SelectedItemChangedCommand="{Binding Path=SelectedItemChangedCommand}"
                        ItemsSource="{Binding Path=Groups}">
                        <TreeView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource StrechedTreeViewItemStyle}" TargetType="{x:Type TreeViewItem}">
                                <Setter Property="Foreground" Value="{StaticResource FontColor}" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="TreeViewItem.IsExpanded" Value="{Binding Path=IsExpanded, Mode=TwoWay}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>

                    <Grid Grid.Row="3" Margin="4,0,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Margin="2,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="#9A9A9A"
                            Text="{Binding Path=StatusText}"
                            TextTrimming="CharacterEllipsis" />

                        <Button
                            Grid.Column="1"
                            Height="18"
                            Padding="6,0,6,0"
                            Command="{Binding Path=PlaceCommand}"
                            Content="{Binding Path=PlaceButtonText}"
                            ToolTip="进入/退出点击放置模式（Esc 取消）" />
                    </Grid>
                </Grid>
            </Border>
        </ctrl:FrostyDockablePanel>
    </DataTemplate>

</ResourceDictionary>
